[
  {
    "channel": "website",
    "name": "Kênh Website",
    "fields": [
      {
        "key": "website_name",
        "label": "Tên inbox",
        "type": "text",
        "required": true,
        "placeholder": "Nhập tên inbox (vd: Support)"
      },
      {
        "key": "website_domain",
        "label": "Website URL",
        "type": "url",
        "required": true,
        "placeholder": "https://example.com",
        "helperText": "URL trang sẽ nhúng widget chat."
      },
      {
        "key": "widget_color",
        "label": "Màu widget",
        "type": "color",
        "required": false
      },
      {
        "key": "welcome_heading",
        "label": "Welcome title",
        "type": "text",
        "required": false,
        "placeholder": "Welcome to our support"
      },
      {
        "key": "welcome_tagline",
        "label": "Welcome tagline",
        "type": "textarea",
        "required": false,
        "maxLength": 255,
        "placeholder": "We are here to help you"
      },
      {
        "key": "reply_time",
        "label": "Thời gian phản hồi",
        "type": "select",
        "required": false,
        "default": "in_a_few_minutes",
        "options": [
          { "label": "Vài phút", "value": "in_a_few_minutes" },
          { "label": "Vài giờ", "value": "in_a_few_hours" },
          { "label": "Trong ngày", "value": "in_a_day" }
        ]
      },
      {
        "key": "continuity_via_email",
        "label": "Tiếp tục hội thoại qua email",
        "type": "checkbox",
        "required": false,
        "default": true
      },
      {
        "key": "enable_channel_greeting",
        "label": "Bật lời chào kênh",
        "type": "select",
        "required": false,
        "default": "disabled",
        "options": [
          { "label": "Tắt", "value": "disabled" },
          { "label": "Bật", "value": "enabled" }
        ]
      },
      {
        "key": "greeting_message",
        "label": "Nội dung lời chào",
        "type": "textarea",
        "required": false,
        "maxLength": 255,
        "placeholder": "Hello, how can I help you?"
      }
    ]
  },
